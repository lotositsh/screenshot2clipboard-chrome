{
  "manifest_version": 3,
  "name": "Shot to ImgBB",
  "version": "5.1",
  "minimum_chrome_version": "116",
  "description": "One click screenshot of the visible tab. Copy to clipboard or upload to imgbb.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "clipboardWrite"],
  "host_permissions": ["https://api.imgbb.com/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Take screenshot",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
